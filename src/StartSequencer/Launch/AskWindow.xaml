<ui:FluentWindow x:Class="StartSequencer.Launch.AskWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="StartSequencer"
                 Width="420"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 ShowInTaskbar="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="StartSequencer" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Start these now?"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16" />
            <ItemsControl x:Name="ItemsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </CheckBox>
                            <TextBlock Text="Stage" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding StageCaptionVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CountdownText" FontSize="12" Margin="0,16,0,12"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Start selected" Appearance="Primary" IsDefault="True" Click="StartSelected_Click" />
                <ui:Button Content="Start all" Margin="8,0,0,0" Click="StartAll_Click" />
                <ui:Button Content="Skip all" Margin="8,0,0,0" IsCancel="True" Click="SkipAll_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
