<Application x:Class="StartSequencer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Semantic colors, light values. App.ApplySemanticBrushes swaps them with the theme. -->
            <SolidColorBrush x:Key="SsWarnBrush" Color="#C19C00" />
            <SolidColorBrush x:Key="SsOkBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="SsFailBrush" Color="#C42B1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
