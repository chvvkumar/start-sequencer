<ui:FluentWindow x:Class="StartSequencer.UI.AddEntryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add entry"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar Title="StartSequencer" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Add entry" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock Text="Program, shortcut or script" Style="{StaticResource Label}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="PathBox" TextChanged="PathBox_TextChanged" />
                <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
            </Grid>

            <TextBlock Text="Name" Style="{StaticResource Label}" />
            <ui:TextBox x:Name="NameBox" />

            <TextBlock Text="Arguments" Style="{StaticResource Label}" />
            <ui:TextBox x:Name="ArgsBox" />

            <TextBlock Text="Working directory" Style="{StaticResource Label}" />
            <ui:TextBox x:Name="DirBox" />

            <TextBlock Text="Stage" Style="{StaticResource Label}" />
            <ComboBox x:Name="StageBox" HorizontalAlignment="Left" MinWidth="200" />

            <TextBlock x:Name="ErrorText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SsFailBrush}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button Content="Add" MinWidth="88" IsDefault="True" Click="Add_Click" />
                <ui:Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
